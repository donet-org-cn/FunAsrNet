<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Package.props" />
  <PropertyGroup>
    <PackageId>FunAsrNet.Vulkan</PackageId>
    <Description>Optional Vulkan GPU backend for FunAsrNet: FP32 projections, convolutions and attention, and original Q8_0 projections. Requires a compatible system Vulkan driver. Model weights are supplied separately.</Description>
    <PackageTags>FunASR;ASR;TTS;Vulkan;GPU;speech</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FunAsrNet/FunAsrNet.csproj" />
    <None Include="Vendor/LICENSE" Pack="true" PackagePath="licenses/SimdPaddleOCR/" />
    <None Include="Vendor/README.md" Pack="true" PackagePath="licenses/SimdPaddleOCR/README.md" />
  </ItemGroup>
</Project>
